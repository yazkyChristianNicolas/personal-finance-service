// Personal Finance Service — data model
// Fase 1 implementa lógica/endpoints para: User, Group, GroupMember, PaymentMethod,
// Expense, ExpenseSplit, ApiKey.
// RecurringTemplate, InstallmentPlan, CardStatement y StatementItem se modelan ya porque
// Expense las referencia por FK, pero su lógica de negocio llega en fases 2/3.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id // sub de Keycloak
  email       String   @unique
  displayName String?
  createdAt   DateTime @default(now())

  groupMemberships   GroupMember[]
  paymentMethods     PaymentMethod[]
  apiKeys            ApiKey[]
  expensesCreated    Expense[]           @relation("CreatedBy")
  recurringTemplates RecurringTemplate[]
  cardStatements     CardStatement[]

  @@map("users")
}

model Group {
  id        String   @id @default(uuid())
  name      String
  isDefault Boolean  @default(false) // grupo "Personal" auto-creado por usuario
  createdAt DateTime @default(now())

  members            GroupMember[]
  expenses           Expense[]
  recurringTemplates RecurringTemplate[]

  @@map("groups")
}

enum GroupRole {
  OWNER
  MEMBER
}

model GroupMember {
  id        String    @id @default(uuid())
  userId    String
  groupId   String
  role      GroupRole @default(MEMBER)
  createdAt DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId]) // cubre "mis grupos" (Group.search) y el chequeo de membresía
  @@index([groupId]) // cubre "miembros de un grupo" (searchMembers) y el cálculo de splits (getMemberUserIds)
  @@map("group_members")
}

enum PaymentMethodType {
  CASH
  DEBIT
  CREDIT
}

model PaymentMethod {
  id                String            @id @default(uuid())
  userId            String
  name              String
  type              PaymentMethodType
  billingCycleStart Int? // día del mes, solo para CREDIT
  billingCycleEnd   Int? // día del mes, solo para CREDIT
  createdAt         DateTime          @default(now())

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses           Expense[]
  recurringTemplates RecurringTemplate[]
  cardStatements     CardStatement[]

  @@index([userId]) // GET /payment-methods: único filtro de search()
  @@map("payment_methods")
}

model Expense {
  id                  String   @id @default(uuid())
  date                DateTime
  amount              Int // en centavos
  currency            String // ISO 4217, ej "ARS", "USD"
  description         String
  category            String
  groupId             String
  paymentMethodId     String
  createdByUserId     String
  isRecurring         Boolean  @default(false)
  recurringTemplateId String?
  installmentPlanId   String?
  createdAt           DateTime @default(now())

  group                Group              @relation(fields: [groupId], references: [id], onDelete: Restrict)
  paymentMethod        PaymentMethod      @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  createdBy            User               @relation("CreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  splits               ExpenseSplit[]
  recurringTemplate    RecurringTemplate? @relation(fields: [recurringTemplateId], references: [id])
  installmentPlan      InstallmentPlan?   @relation(fields: [installmentPlanId], references: [id])
  matchedStatementItem StatementItem?

  // GET /expenses: group_id (siempre presente, viene de la membresía) + rango date_from/date_to
  // + ORDER BY date DESC — el filtro obligatorio de search(), cubre el caso de uso principal.
  @@index([groupId, date])
  // Sin uso por search() hoy — category/currency/payment_method_id son filtros opcionales de
  // baja selectividad que siempre van acompañados de group_id, así que el índice de arriba ya
  // los cubre razonablemente bien. Este índice existe por el onDelete: Restrict de la FK
  // paymentMethod (Postgres necesita recorrer rápido "¿hay expenses con este payment_method_id?"
  // al intentar borrar un PaymentMethod), no por búsqueda.
  @@index([paymentMethodId])
  // Ídem — onDelete: Restrict de la FK createdBy. No hay filtro por creador en ningún endpoint hoy.
  @@index([createdByUserId])
  @@map("expenses")
}

enum SplitStrategy {
  EQUAL // 50/50 o N-way equal
  PERCENTAGE // asimétrico por porcentaje
  ROMANA // "a la romana" (proporcional a algún criterio, ej. ingreso)
}

model ExpenseSplit {
  id         String   @id @default(uuid())
  expenseId  String
  userId     String
  amount     Int // monto que le corresponde a este miembro (centavos)
  percentage Float? // opcional, según estrategia
  createdAt  DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId]) // ExpensesRepository.findById/search hacen include: { splits: true }
  // Sin uso por ningún endpoint hoy — no existe todavía un "mis splits"/balance entre usuarios.
  // Se deja a propósito (decisión 2026-08-24): la feature de "quién le debe a quién" es muy
  // probable dado que el modelo de splits ya existe, y el costo de mantenerlo es bajo. Si en
  // unos meses sigue sin usarse, sacarlo.
  @@index([userId])
  @@map("expense_splits")
}

model RecurringTemplate {
  id              String  @id @default(uuid())
  userId          String
  amount          Int
  currency        String
  description     String
  category        String
  groupId         String
  paymentMethodId String
  dayOfMonth      Int // día en que se genera el gasto
  active          Boolean @default(true)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  group         Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  expenses      Expense[]

  @@index([userId])
  @@map("recurring_templates")
}

model InstallmentPlan {
  id                 String @id @default(uuid())
  totalAmount        Int
  installmentsCount  Int
  currentInstallment Int    @default(1)

  expenses Expense[]

  @@map("installment_plans")
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  label      String
  hash       String    @unique // sha256 de la key
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId]) // GET /api-keys: único filtro de search()
  @@map("api_keys")
}

model CardStatement {
  id              String   @id @default(uuid())
  userId          String
  paymentMethodId String
  periodStart     DateTime
  periodEnd       DateTime
  importedAt      DateTime @default(now())

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod   @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  items         StatementItem[]

  @@index([userId])
  @@map("card_statements")
}

model StatementItem {
  id               String   @id @default(uuid())
  cardStatementId  String
  rawDescription   String
  amount           Int
  date             DateTime
  matchedExpenseId String?  @unique // null = sin matchear
  matchConfidence  Float?

  cardStatement  CardStatement @relation(fields: [cardStatementId], references: [id], onDelete: Cascade)
  matchedExpense Expense?      @relation(fields: [matchedExpenseId], references: [id])

  @@index([cardStatementId])
  @@map("statement_items")
}
