# --- API ---
API_PORT=3000
NODE_ENV=development

# --- api-db (Postgres para la app) ---
API_DB_USER=finance
API_DB_PASSWORD=finance
API_DB_NAME=finance
API_DB_PORT=5432
DATABASE_URL=postgresql://finance:finance@localhost:5432/finance?schema=public

# --- keycloak-db (Postgres dedicada a Keycloak) ---
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_DB_NAME=keycloak

# --- Keycloak ---
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=personal-finance
# Issuer esperado en el claim `iss` del JWT (debe matchear KC_HOSTNAME del servicio keycloak
# en docker-compose.yml). Corriendo la API fuera de docker (npm run start:dev) esto alcanza
# también para pedir el JWKS.
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/personal-finance
# Solo necesario si la API corre DENTRO de docker compose: ahí `localhost` no llega al
# contenedor de keycloak, así que docker-compose.yml pisa esta var con el hostname interno
# `keycloak`. No hace falta setearla acá para desarrollo local fuera de docker.
# KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/personal-finance/protocol/openid-connect/certs
